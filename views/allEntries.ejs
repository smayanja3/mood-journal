<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/allEntries.css">
    <title>New Entry</title>
</head>

<body>
    <header>
        <h2 class="logo">Mood Journal</h2>
        <nav>
            <ul>
                <l1><a href="/entries/new">Add an Entry</a></l1>
            </ul>
        </nav>
    </header>

    <main>
            <h1>My Journal</h1>
    
        <div class="statsSection">
            <p>Todays Mood</p>
            <p>Daily Streak</p>
        </div>

        <section class="entries">
           <% if (entries.length === 0) { %>
                <p>No Journal Entries<a href="/entries/new"></a></p>
           <% } %>


           <% entries.forEach((entry) => { %>
            <!-- <a href="" class="" > -->
            <div class="entryOne">
                <div>

                    <div class="entryTop">
                        <p class="date"><%= entry.displayDate %></p>
                        <p class="mood <%= entry.mood %>"><%= entry.mood %></p>
                    </div>
                    
                    <% if ( entry.moodScale) { %>
                        <p class="scale">Mood scale <%= entry.moodScale %> /10</p>
                  <% } %>

                    <p class="journal"><%= entry.journal %></p>

                        <% if ( entry.tags) { %>
                        <p class="tags"><%= entry.tags %></p>
                  <% } %>

                </div>
                <div class="actions">
                    <a href="/entries/edit/<%= entry._id %>" class="btn">Edit</a>
                    <button class="deleteBtn" data-id="<%= entry._id %>">Delete</button>
                </div>
            </div>

          <% }) %>

        </section>


    </main>
    <script src="/js/main.js"></script>
</body>

</html>