<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/edit.css">
    <title>New Entry</title>
</head>

<body>

    <header>
        <h2 class="logo">Mood Journal</h2>
        <nav>
            <ul>
                <l1><a href="/entries">View All</a></l1>
                <l1><a href="/entries/new">Add an Entry</a></l1>
            </ul>
        </nav>
    </header>

    <main> 
         <div id="container">
        <h1>Adding more to this entry...</h1>
        <form id="editForm" data-id="<%= entry._id %>" required>
             <div id="formTop">
            <label>Date <input type="date" name="date" value="<%= entry.inputDate %>"></label>

            <label for="mood">Mood
                <select name="mood" id="mood">
                    <option value="great" <%= entry.mood === 'great' ? 'selected' : '' %>>Great</option>
                    <option value="good" <%= entry.mood === 'good' ? 'selected' : '' %>>Good</option>
                    <option value="calm" <%= entry.mood === 'calm' ? 'selected' : '' %>>Calm</option>
                    <option value="okay" <%= entry.mood === 'okay' ? 'selected' : '' %>>Okay</option>
                    <option value="low" <%= entry.mood === 'low' ? 'selected' : '' %>>Low</option>
                    <option value="anxious" <%= entry.mood === 'anxious' ? 'selected' : '' %>>Anxious</option>
                    <option value="overwhelmed" <%= entry.mood === 'overwhelmed' ? 'selected' : '' %>>Overwhelmed</option>
                    <option value="rough" <%= entry.mood === 'rough' ? 'selected' : '' %>>Rough</option>
                </select>
            </label>

            <label>Mood scale (1-10) <input type="number" name="moodScale"  min="1" max="10" value="<%= entry.moodScale %>"></label>
            <label>Tags <input type="text" name="tags" value="<%= entry.tags %>"></label>
            </div>

            <label>Journal Entry <textarea type="text" name="journal" row="10"required><%= entry.journal %></textarea></label>
            

             <p id="error-message"></p>
            <div id="formBottom">
            <button class="Submit">Save Entry</button>
            <a href="/entries">Cancel</a>
             </div>
        </form>
         </div>
    </main>
    <script src="/js/main.js"></script>
</body>

</html>